# ============================================================
#  Modcheck Bot – .env Vorlage
#  Kopieren nach .env und mit echten Werten befüllen:
#    cp .env.example .env
#
#  WICHTIG: .env enthält sensible Daten – nie committen!
#  (steht bereits in .gitignore)
# ============================================================

# ── PFLICHT ────────────────────────────────────────────────

# Discord Bot Token
# (Discord Developer Portal → Bot → Token)
DISCORD_TOKEN=your_discord_bot_token_here

# ID deines Servers (Guild). Aktiviert die lokale Command-Sync
# (schneller, kein 1h-Global-Delay).
GUILD_ID=0

# OpenRouter API Key (für AI-Antworten & Übersetzung)
# Mehrere Keys mit Komma trennen = automatisches Key-Rotation:
OPENROUTER_API_KEY=your_openrouter_api_key_here
#OPENROUTER_KEYS=key1,key2,key3
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#AI_MODEL_NAME=openai/gpt-4o-mini
#MODERATION_MODEL=openai/gpt-4o-mini

# ── TICKET-SYSTEM ──────────────────────────────────────────

# Kategorie, in der Ticket-Kanäle erstellt werden (0 = ohne)
TICKET_CATEGORY_ID=0
# Log-Kanal für Ticket-Ereignisse (0 = LOG_CHANNEL_ID)
TICKET_LOG_CHANNEL_ID=0
# Rolle, die Tickets claimen/schließen darf
TICKET_SUPPORT_ROLE=Support

# ── SERVER / LOGGING ───────────────────────────────────────

# Log-Kanal für Mod-Aktionen & Events
LOG_CHANNEL_ID=0
# Kanal, der Twitch-Mod-Aktionen loggt (0 = deaktiviert)
TWITCH_LOG_CHANNEL_ID=0
# Kanal für gelöscht/bearbeitete Nachrichten (0 = deaktiviert)
MESSAGE_LOG_CHANNEL_ID=0
# Rolle des Mod-Teams
MOD_ROLE_NAME=Moderator
# Komma-getrennte User-IDs, die Admin-Befehle dürfen
ADMIN_USER_IDS=

# ── MUSIK ──────────────────────────────────────────────────

# Musik-Modul an/aus (true/false)
MUSIC_ENABLED=true
# Sekunden Inaktivität bis der Bot den Voice-Kanal verlässt
MUSIC_IDLE_TIMEOUT=180
# Spotify-Client (optional – ohne Standard-Werte werden genutzt)
#SPOTIFY_CLIENT_ID=
#SPOTIFY_CLIENT_SECRET=

# ── TEMPORÄRE VOICE-KANÄLE ─────────────────────────────────

# Trigger-Kanal (Bitritt = eigener VC wird erstellt)
TEMP_VOICE_CHANNEL_ID=0
# Kategorie für die angelegten Kanäle (0 = Kategorie des Triggers)
TEMP_VOICE_CATEGORY_ID=0

# ── GAMBLING / MINI-GAMES ──────────────────────────────────

GAMBLING_CHANNEL_ID=0
FISHING_CHANNEL_ID=0
GAMBLING_BANK_FILE=bank.json
DATA_FILE=data.json
#Crash-Games Cheat: true/false
CRASH_CHEAT=false

# ── TWITCH BOT ─────────────────────────────────────────────
# (nur aktiv wenn TWITCH_TOKEN gesetzt ist)

TWITCH_TOKEN=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_BOT_ID=
# Kanal des Streamers (nur Name, klein)
STREAMER_CHANNEL=
# User-ID des Streamers (für Clips/Rewards)
STREAMER_USER_ID=
# OAuth-Token des Streamers (für Channel-Rewards)
STREAMER_OAUTH_TOKEN=

# ── KI / DIVERSES ──────────────────────────────────────────

# ProxyCheck.io API-Key (IP-Check, optional)
PROXYCHECK_API_KEY=
# Auto-Rolle für neue Mitglieder (leer = deaktiviert)
AUTO_ROLE_NAME=Zuschauer
# Verifizierung / Verifier
VERIFIED_ROLE_ID=0
VERIFIER_URL=
WEBHOOK_SECRET=
# Wochenreview-Kanal (0 = deaktiviert)
REVIEW_CHANNEL_ID=0
# Clips-Kanal + Userinfo-Kanal (0 = deaktiviert)
CLIPS_CHANNEL_ID=0
USERINFO_CHANNEL_ID=0

# ── DASHBOARD (läuft im Bot-Prozess) ──────────────────────

# Port des Dashboards
DASHBOARD_PORT=5000
# Secret für Sessions (im Produktivbetrieb ändern!)
DASHBOARD_SECRET=bygorgii_dashboard_secret_change_me
#DASHBOARD_DEBUG=false
# OAuth-Login (optional – ohne ist User/Passwort-Login)
#DISCORD_CLIENT_ID=
#DISCORD_CLIENT_SECRET=
#DISCORD_REDIRECT_URI=
